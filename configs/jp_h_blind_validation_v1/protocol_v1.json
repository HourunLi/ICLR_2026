  "outputs": {
    "source_questions": "run_artifacts/jp_h_blind_validation_v1/acquisition/source_questions_v1.jsonl",
    "candidate_pool": "run_artifacts/jp_h_blind_validation_v1/acquisition/candidate_pool_v1.jsonl",
