    "private_lineage": "run_artifacts/jp_h_blind_validation_v1/acquisition/private_lineage_v1.jsonl",
    "annotation_items": "configs/jp_h_blind_validation_v1/annotation_items_v1.jsonl",
    "package_report": "configs/jp_h_blind_validation_v1/package_report_v1.json"
  },
  "frozen_candidate": {
    "readout": "single final linear JP-to-H head trained only on the old adjudicated 64-row development set",
    "smoother": "three-token masked centered arithmetic mean in logit space",
    "window": 3,
    "causal": false,
    "new_label_access_before_scoring_forbidden": true,
    "additional_window_or_architecture_sweep_forbidden": true
  },
  "prohibitions": {
    "pilot_test_access_allowed": false,
    "final_test_access_allowed": false,
    "score_coupling_authorized": false,
    "method_adopted_before_blind_gate": false,
    "primary_secondary_label_leakage_allowed": false
